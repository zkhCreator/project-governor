{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Governor Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "reviewer",
    "candidate_digest",
    "contract_digest",
    "violations",
    "unverified"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "reviewer": {
      "type": "string",
      "enum": ["architecture", "ui"]
    },
    "candidate_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "contract_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "state", "observation", "conflict", "evidence_refs"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "conflict": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "required_evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "required_evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
